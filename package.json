{
  "name": "pithos",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "pnpm --filter @pithos/sim build && pnpm --filter @pithos/render build",
    "dev": "pnpm run build:packages && pnpm --filter game dev",
    "build": "pnpm run build:packages && pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm run build:packages && pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
